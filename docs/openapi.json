{
  "openapi": "3.1.0",
  "info": {
    "title": "Messer Paste",
    "version": "0.2.0",
    "description": "Single-user pastebin. Text, images and files with expiry, burn-after-reading and SSE live updates. Machine clients authenticate with a bearer token from a 0600 file, or a service token for the proxy in front."
  },
  "servers": [
    {
      "url": "https://paste.example.com",
      "description": "private app (behind your own access layer)"
    },
    {
      "url": "https://pub.example.com",
      "description": "public reader: GET a paste, its raw text and its files, plus unlock"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "File": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "public id"
          },
          "name": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          }
        }
      },
      "Match": {
        "type": "object",
        "properties": {
          "field": {
            "enum": [
              "title",
              "files",
              "text"
            ]
          },
          "snippet": {
            "type": "string",
            "description": "matched fragment; U+0001/U+0002 wrap the hit"
          }
        }
      },
      "Paste": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "text",
              "images",
              "files",
              "mixed"
            ]
          },
          "text_bytes": {
            "type": "integer"
          },
          "file_bytes": {
            "type": "integer"
          },
          "file_count": {
            "type": "integer"
          },
          "views": {
            "type": "integer"
          },
          "burn": {
            "type": "boolean"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "text": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/File"
            }
          },
          "match": {
            "$ref": "#/components/schemas/Match"
          },
          "visibility": {
            "enum": [
              "private",
              "public"
            ],
            "description": "public pastes are readable on the public host without Access"
          },
          "max_views": {
            "type": [
              "integer",
              "null"
            ],
            "description": "null = no cap; counts distinct readers, one per hour"
          },
          "locked": {
            "type": "boolean",
            "description": "true when the paste needs a password; text and files are omitted"
          }
        }
      },
      "Page": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Paste"
            }
          },
          "next_cursor": {
            "type": "string"
          },
          "has_more": {
            "type": "boolean"
          },
          "total": {
            "type": "integer"
          },
          "took_ms": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "E_NOT_FOUND"
              },
              "message": {
                "type": "string"
              },
              "field": {
                "type": "string",
                "description": "the form control an E_INVALID belongs to"
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "dependencies",
        "security": [],
        "responses": {
          "200": {
            "description": "ready"
          },
          "503": {
            "description": "database or content volume unavailable"
          }
        }
      }
    },
    "/api/v1/pastes": {
      "get": {
        "summary": "list or search",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "create",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  },
                  "expires_in": {
                    "type": "integer",
                    "description": "seconds; 0 = never"
                  },
                  "burn": {
                    "type": "boolean"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "visibility": {
                    "enum": [
                      "private",
                      "public"
                    ]
                  },
                  "password": {
                    "type": "string",
                    "description": "min 8 chars; public only"
                  },
                  "max_views": {
                    "type": "integer",
                    "description": "0 or absent = no cap; public only"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paste"
                }
              }
            }
          },
          "413": {
            "description": "too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "purge every paste",
        "responses": {
          "200": {
            "description": "{deleted: n}"
          }
        }
      }
    },
    "/api/v1/pastes/{slug}": {
      "get": {
        "summary": "read",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "paste",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paste"
                }
              }
            }
          },
          "409": {
            "description": "burn paste: use /reveal"
          },
          "410": {
            "description": "burned or expired"
          }
        }
      },
      "put": {
        "summary": "replace",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "updated"
          }
        }
      },
      "delete": {
        "summary": "delete one",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "deleted"
          }
        }
      }
    },
    "/api/v1/pastes/{slug}/raw": {
      "get": {
        "summary": "plain text body",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "text/plain"
          }
        }
      }
    },
    "/api/v1/pastes/{slug}/files/{id}": {
      "get": {
        "summary": "stream a file",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "download",
            "in": "query",
            "schema": {
              "enum": [
                "0",
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "bytes",
            "content": {
              "application/octet-stream": {}
            }
          }
        }
      }
    },
    "/api/v1/pastes/{slug}/reveal": {
      "post": {
        "summary": "burn: return the payload and delete it",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "payload"
          },
          "410": {
            "description": "already revealed"
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "summary": "SSE: paste.created|updated|deleted|purged",
        "responses": {
          "200": {
            "description": "text/event-stream"
          }
        }
      }
    },
    "/api/v1/config": {
      "get": {
        "summary": "which host is which",
        "security": [],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "public_host": {
                      "type": "string",
                      "description": "empty when the public host is disabled"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pastes/{slug}/unlock": {
      "post": {
        "summary": "unlock a password-protected public paste",
        "description": "Sets an HttpOnly cookie valid for one hour. Rate limited per IP.",
        "security": [],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "password"
                ],
                "properties": {
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "unlocked; the cookie is set"
          },
          "401": {
            "description": "wrong password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not a public paste",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "too many attempts"
          }
        }
      }
    },
    "/api/v1/settings": {
      "get": {
        "summary": "Every setting, its value, and the layer that set it",
        "responses": {
          "200": {
            "description": "The catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "env": {
                            "type": "string"
                          },
                          "group": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "int",
                              "bool",
                              "enum",
                              "duration",
                              "text",
                              "list"
                            ]
                          },
                          "unit": {
                            "type": "string"
                          },
                          "default": {},
                          "min": {
                            "type": "integer"
                          },
                          "max": {
                            "type": "integer"
                          },
                          "choices": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "boot": {
                            "type": "boolean"
                          },
                          "advanced": {
                            "type": "boolean"
                          },
                          "value": {},
                          "source": {
                            "type": "string",
                            "enum": [
                              "default",
                              "env",
                              "custom"
                            ]
                          },
                          "editable": {
                            "type": "boolean"
                          }
                        }
                      }
                    },
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "custom": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Write settings",
        "description": "Validates the whole body before writing anything. A key the environment owns answers 409 E_PINNED; a boot-only key answers 409 too.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The catalog after the write",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "env": {
                            "type": "string"
                          },
                          "group": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "int",
                              "bool",
                              "enum",
                              "duration",
                              "text",
                              "list"
                            ]
                          },
                          "unit": {
                            "type": "string"
                          },
                          "default": {},
                          "min": {
                            "type": "integer"
                          },
                          "max": {
                            "type": "integer"
                          },
                          "choices": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "boot": {
                            "type": "boolean"
                          },
                          "advanced": {
                            "type": "boolean"
                          },
                          "value": {},
                          "source": {
                            "type": "string",
                            "enum": [
                              "default",
                              "env",
                              "custom"
                            ]
                          },
                          "editable": {
                            "type": "boolean"
                          }
                        }
                      }
                    },
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "custom": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "E_UNKNOWN_SETTING",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "E_PINNED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "E_INVALID, with the field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings/{key}": {
      "delete": {
        "summary": "Drop a stored value so the default takes over",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The catalog after the reset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "env": {
                            "type": "string"
                          },
                          "group": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "int",
                              "bool",
                              "enum",
                              "duration",
                              "text",
                              "list"
                            ]
                          },
                          "unit": {
                            "type": "string"
                          },
                          "default": {},
                          "min": {
                            "type": "integer"
                          },
                          "max": {
                            "type": "integer"
                          },
                          "choices": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "boot": {
                            "type": "boolean"
                          },
                          "advanced": {
                            "type": "boolean"
                          },
                          "value": {},
                          "source": {
                            "type": "string",
                            "enum": [
                              "default",
                              "env",
                              "custom"
                            ]
                          },
                          "editable": {
                            "type": "boolean"
                          }
                        }
                      }
                    },
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "custom": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "E_PINNED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
